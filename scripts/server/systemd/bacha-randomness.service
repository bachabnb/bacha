[Unit]
Description=Bacha randomness worker
After=network-online.target
Wants=network-online.target

[Service]
User=bacha
Group=bacha
WorkingDirectory=/opt/bacha
EnvironmentFile=/etc/bacha/launch.env
EnvironmentFile=/etc/bacha/worker.env
EnvironmentFile=/etc/bacha/committer.env
ExecStart=/usr/bin/node scripts/randomness-worker.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/bacha

[Install]
WantedBy=multi-user.target
