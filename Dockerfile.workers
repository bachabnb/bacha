# The Bacha worker as one small image: it commits and reveals randomness and
# delivers each settled prize (swapping its BNB into the stock on PancakeSwap).
#
#   RAILWAY_DOCKERFILE_PATH=Dockerfile.workers   (service variable)
#   BACHA_WORKER=randomness
#   BACHA_WORKER_ARGS=--once                     (optional: override the flags)
#
# The worker imports nothing but viem, so the website's dependencies are left
# out. Keep the version in step with package-lock.json.
FROM node:24-slim

WORKDIR /app
RUN npm init -y >/dev/null && npm install --no-audit --no-fund --loglevel=error viem@2.56.8

COPY data/tokens.json data/tokens.json
COPY scripts/randomness-worker.mjs scripts/
COPY scripts/lib/routes.mjs scripts/lib/

ENV NODE_ENV=production

CMD ["sh", "-c", "case \"$BACHA_WORKER\" in \
  randomness) exec node scripts/randomness-worker.mjs ${BACHA_WORKER_ARGS:-} ;; \
  *) echo 'Set BACHA_WORKER=randomness (the treasury and governor workers were retired).' >&2; exit 1 ;; \
esac"]
