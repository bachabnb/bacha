# ============================================================================
# BACHA — environment
#
# Copy to .env.local for development. Never commit a filled-in copy.
#
# Two rules, both load-bearing:
#   1. NEXT_PUBLIC_* is inlined into the browser bundle. Anything secret must
#      not carry that prefix — there is no way to un-ship it afterwards.
#   2. Every variable below is optional in the sense that the app still boots
#      without it. What changes is capability, not stability: with no
#      contracts configured the machine runs in a clearly-labelled demo mode.
# ============================================================================


# ---------------------------------------------------------------- network ---

# 56 = BNB Smart Chain mainnet, 97 = BNB Smart Chain testnet.
NEXT_PUBLIC_CHAIN_ID=56

# Leave unset to use the public BNB Chain dataseed. A dedicated RPC endpoint is
# strongly recommended for anything real — the public one rate-limits, and the
# activity feed reads logs.
NEXT_PUBLIC_BSC_RPC_URL=

# WalletConnect Cloud project id. Without it the WalletConnect connector is
# omitted entirely rather than shipped in a state that throws on click.
# https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Absolute origin, used for canonical URLs, Open Graph and hreflang.
NEXT_PUBLIC_SITE_URL=https://bacha.example


# -------------------------------------------------------------- contracts ---

# Set both to switch the app from demo mode to real onchain settlement.
# Leaving them unset is a supported state: the site runs, labels every result
# as simulated, and never presents a demo spin as a transaction.
NEXT_PUBLIC_BACHA_GAME_ADDRESS=
NEXT_PUBLIC_BACHA_RANDOMNESS_ADDRESS=
NEXT_PUBLIC_BACHA_VAULT_ADDRESS=


# ------------------------------------------------------------ market data ---

# Optional CoinGecko Pro key. Without it the free endpoint is used and cached
# server-side. If the feed fails entirely, prices are hidden rather than
# guessed — and the machine keeps running, because a price is never an input
# to settlement.
COINGECKO_API_KEY=

# Optional. Used by contract verification tooling, not by the running app.
BSCSCAN_API_KEY=


# ---------------------------------------------------------- content build ---

# Server-side only. Used by `npm run art:generate` to produce the art pack.
# This is a build-time content pipeline — it never runs for a website visitor,
# and the key must never reach the browser.
OPENAI_API_KEY=

# Optional override for the image model used by the art pipeline.
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst


# -------------------------------------------------------------- indexing ---

# Optional. When set, a lightweight indexed copy of spin events can be kept for
# a faster feed. The contract remains the source of truth: an indexed row is
# only ever used to *find* a spin, never to override what the chain recorded.
DATABASE_URL=


# ----------------------------------------------------------------- admin ---

# Unlocks the operator console at /admin. Without it the console is disabled
# outright rather than left open. Use a long random value.
#   openssl rand -hex 32
BACHA_ADMIN_TOKEN=

# Comma-separated wallets expected to execute admin transactions. This is
# documentation for the console, not access control — real authority lives in
# DEFAULT_ADMIN_ROLE and OPERATOR_ROLE on the contracts, which should be held
# by a multisig in production.
BACHA_ADMIN_ADDRESSES=


# ------------------------------------------------------------ settlement ---

# OPTIONAL, SERVER-SIDE ONLY, AND NOT RECOMMENDED AS PLAINTEXT.
#
# A settlement worker can call `claimFor(spinId)` so players do not have to
# claim manually. It takes no custody and cannot redirect anything: the
# recipient was written into spin state before randomness existed.
#
# Even so, a hot key in a deployment environment variable is not good custody.
# Prefer a KMS/HSM signer, or simply leave this unset — players can always
# claim their own rewards, and the contract makes that a first-class path.
SETTLEMENT_PRIVATE_KEY=


# ----------------------------------------------------------- compliance ---

# Optional ISO 3166-1 alpha-2 codes, comma-separated. When set, requests from
# these countries are routed to /unavailable by middleware before they can
# reach a page that takes money. Unset means no geofence is applied — Bacha
# makes no claim about where it is or is not permitted.
BACHA_BLOCKED_COUNTRIES=

# Minimum age asserted by the entry gate.
BACHA_MINIMUM_AGE=18


# ============================================================================
# CONTRACT DEPLOYMENT (contracts/ only — not read by the web app)
# ============================================================================

# Deployer key. Use a throwaway key that holds only gas, and hand every role to
# a multisig immediately after deploying.
PRIVATE_KEY=

# Address that receives DEFAULT_ADMIN_ROLE, OPERATOR_ROLE and TREASURER_ROLE.
# On mainnet this should be a multisig, never an EOA.
BACHA_ADMIN=

# Chainlink VRF v2.5. Confirm against docs.chain.link before deploying —
# coordinators do get rotated.
#   BNB mainnet  0xd691f04bc0C9a24Edb78af9E005Cf85768F694C9
#   BNB testnet  0xDA3b641D438362C440Ac5458c57e00a712b66700
VRF_COORDINATOR=
VRF_KEY_HASH=
VRF_SUBSCRIPTION_ID=
VRF_CALLBACK_GAS_LIMIT=500000
VRF_CONFIRMATIONS=3
VRF_NATIVE_PAYMENT=false

# RPC endpoints for forge script / forge verify.
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# Prize table to publish, as JSON. See contracts/script/PublishTable.s.sol.
BACHA_TABLE_FILE=./tables/quick.json

# ---------------------------------------------------------------------------
# Treasury worker (scripts/treasury-worker.mjs)
#
# Hot key. Needs TREASURER_ROLE on the GAME only — vault.fund() is
# permissionless, so it needs no vault role and cannot touch player inventory.
# Keep the balance here low: it is a working float, not a treasury.
# ---------------------------------------------------------------------------
BACHA_TREASURY_KEY=
BACHA_TARGET_SPINS=5
BACHA_GAS_FLOOR_BNB=0.02
BACHA_MAX_SLIPPAGE_BPS=200
BACHA_MAX_SPEND_PER_TICK_BNB=0.05
BACHA_SWEEP_MIN_BNB=0.01

# Profit ladder. Inventory is stocked first, then the reserve is held, and only
# the surplus above both is split. Leave BACHA_PROFIT_ADDRESS unset to compound
# everything. Do NOT take profit without the governor running — see DEPLOYMENT.
BACHA_RESERVE_BNB=0.13
BACHA_PROFIT_ADDRESS=
BACHA_PROFIT_SPLIT_BPS=5000

# ---------------------------------------------------------------------------
# Solvency governor (scripts/solvency-governor.mjs)
#
# Hot key holding OPERATOR_ROLE. Set prizeCeiling on the game for every asset
# before running this live — that ceiling is what bounds a stolen key.
# ---------------------------------------------------------------------------
BACHA_OPERATOR_KEY=
BACHA_TARGET_RTP=0.62
BACHA_RTP_FLOOR=0.55
BACHA_RTP_CEILING=0.70
